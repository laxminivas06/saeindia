# =============================================================================
# SAE INDIA — Autonomous Drone Rescue & QR Mission System
# Configuration Variables
# =============================================================================

# Local Direct ESP32 WebSocket (used when running locally over HTTP)
VITE_ESP32_WS_URL=ws://192.168.31.194:8080/ws

# Production Secure Cloud Relay (used when running on HTTPS / Vercel)
# Point this to your deployed relay server (e.g., wss://saeindia-relay.onrender.com/ws)
VITE_SECURE_RELAY_URL=wss://YOUR-RELAY-DOMAIN/ws

# Secure Relay Authentication Token (must match RELAY_TOKEN on the relay server)
VITE_RELAY_TOKEN=CHANGE_ME
