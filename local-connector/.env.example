# =============================================================================
# SAE INDIA — Local Connector Agent Configuration
# =============================================================================

# ESP32 LAN IP Address and Port (on the same local Wi-Fi / subnet)
ESP32_HOST=192.168.31.194
ESP32_PORT=8080
ESP32_PATH=/ws

# Outbound Cloud Relay WSS Endpoint (No port forwarding needed!)
# e.g., wss://saeindia-relay.onrender.com/connector or ws://localhost:8443/connector
RELAY_URL=wss://YOUR-RELAY-DOMAIN/connector

# Authentication Token matching RELAY_TOKEN set on the cloud relay
RELAY_TOKEN=CHANGE_ME
