{
  "name": "sae-drone-rescue-qr-mission",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node relay-server/server.js",
    "server": "node relay-server/server.js",
    "dev": "node -e \"if(process.env.RENDER){import('./relay-server/server.js')}else{import('child_process').then(cp=>cp.spawn('npx',['vite',...process.argv.slice(1)],{stdio:'inherit',shell:true}))}\"",
    "dev:local": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "build:apk": "npm run build && npx cap sync android && cd android && export ANDROID_HOME=$HOME/Library/Android/sdk && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../saeindia-debug.apk",
    "relay:start": "node relay-server/server.js",
    "connector:start": "node local-connector/connector.js",
    "test:e2e": "node test-e2e.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
